{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Backend: API, Django admin, static, hooks, health, metrics
	@backend path /api/* /admin* /static/* /hooks/* /healthz /metrics
	handle @backend {
		reverse_proxy api:8000
	}

	# Everything else: Next.js
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
