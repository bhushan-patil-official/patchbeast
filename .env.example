# ===== Patchbeast environment. Copy to .env: `cp .env.example .env && make dev` =====
# Everything marked [REQUIRED-PROD] must be set for production. Dev works with defaults.

# --- Core ---
COMPOSE_PROJECT_NAME=patchbeast
DJANGO_ENV=dev                         # dev | prod
DJANGO_SECRET_KEY=dev-insecure-change-me   # [REQUIRED-PROD] long random string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
SITE_URL=http://localhost:3000         # [REQUIRED-PROD] public https://patchbeast.com
DOMAIN=localhost                       # [REQUIRED-PROD] used by Caddy for automatic TLS
ACME_EMAIL=you@example.com             # [REQUIRED-PROD] Let's Encrypt contact

# --- Postgres / Redis ---
POSTGRES_DB=patchbeast
POSTGRES_USER=patchbeast
POSTGRES_PASSWORD=patchbeast           # [REQUIRED-PROD] change
DATABASE_URL=postgres://patchbeast:patchbeast@postgres:5432/patchbeast
REDIS_URL=redis://redis:6379/0

# --- Frontend <-> backend ---
API_INTERNAL_URL=http://api:8000       # server-side fetches from Next
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000   # browser; leave EMPTY in prod (Caddy proxies /api)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
REVALIDATE_URL=http://web:3000/internal/revalidate
REVALIDATE_SECRET=dev-revalidate-secret   # [REQUIRED-PROD] shared by api + web
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=          # e.g. patchbeast.com (empty = analytics off)
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_GSC_VERIFICATION=          # Google Search Console meta token

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=                     # [NEEDS YOUR KEY] empty => classification is skipped, items go to review
LLM_MODEL=claude-haiku-5-5
LLM_PRICE_IN_PER_MTOK=0.10             # USD, used for the spend cap
LLM_PRICE_OUT_PER_MTOK=0.50
LLM_DAILY_CAP_USD=1.00                 # hard daily cap (also editable in admin SiteSetting)
AUTO_PUBLISH_THRESHOLD=0.85            # min confidence for auto-publishing structured facts
RELEVANCE_REJECT_THRESHOLD=0.85        # items the model is this sure are NOT about a tracked game are auto-rejected (kept, not deleted)

# --- YouTube (Data API; playlistItems=1 unit, search=100 => never used) ---
YOUTUBE_API_KEY=                       # [NEEDS YOUR KEY] optional
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_QUOTA_SAFETY_MARGIN=500
WEBSUB_CALLBACK_BASE=                  # public https base for WebSub callbacks (optional)

# --- Email ---
# Dev: Mailpit catches everything (http://localhost:8025). Production: Resend over SMTP, e.g.
#   EMAIL_HOST=smtp.resend.com  EMAIL_PORT=587  EMAIL_USE_TLS=true   EMAIL_USE_SSL=false   (STARTTLS)
#   EMAIL_HOST=smtp.resend.com  EMAIL_PORT=465  EMAIL_USE_TLS=false  EMAIL_USE_SSL=true    (implicit TLS)
#   EMAIL_HOST_USER=resend      EMAIL_HOST_PASSWORD=re_xxxxxxxx   (your Resend API key)
# DEFAULT_FROM_EMAIL must use a domain you verified in Resend (SPF/DKIM records).
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Patchbeast <hello@patchbeast.com>
CONTACT_EMAIL=hello@patchbeast.com

# --- Alerts ---
ALERT_EMAIL_TO=                        # operator email for alerts
TELEGRAM_BOT_TOKEN=                    # optional
TELEGRAM_CHAT_ID=                      # optional
ALERT_COOLDOWN_MINUTES=60
ALERT_5XX_RATE_THRESHOLD=10            # 5xx responses per 5 minutes before alerting

# --- Ops ---
SENTRY_DSN=                            # optional (api + worker)
METRICS_TOKEN=                         # optional; enables /metrics with bearer token
LOG_LEVEL=INFO
BACKUP_RETENTION_DAYS=14

# --- Feature flags (defaults; runtime-overridable in admin > Feature flags) ---
FEATURE_ADS=false
FEATURE_AFFILIATE=false
FEATURE_NEWSLETTER=true
FEATURE_STORIES=true                   # automated drafting of briefings (ALWAYS human-reviewed before publishing)
STORY_MAX_PER_DAY=5                    # cap on new drafts per day (all games)
STORY_SIMILARITY=0.30                  # clustering threshold (higher = stricter grouping)
STORY_WINDOW_DAYS=7                    # look-back window for clustering
FEATURE_TIER2_CHEATS=false
FEATURE_TIER2_MAPS=false
FEATURE_TIER3_ALERTS=false
NEXT_PUBLIC_ADSENSE_CLIENT=            # only used when ads flag is on

# --- Frontend extras ---
CORS_ALLOWED_ORIGINS=http://localhost:3000   # comma list; add your Vercel/production origin if web and api are on different origins
NEXT_PUBLIC_CONTACT_EMAIL=hello@patchbeast.com
NEXT_PUBLIC_ADSENSE_SLOT=              # only used when the ads flag is on and NEXT_PUBLIC_ADSENSE_CLIENT is set
